<Window x:Class="SaveGameSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveGameSync"
        Height="640"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">

        <!-- VISTA PRINCIPAL -->
        <Grid x:Name="LibraryView">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="SaveGameSync"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="⚙"
                        Width="40"
                        Height="40"
                        FontSize="18"
                        ToolTip="Configuración"/>
                <Button x:Name="AddGameButton_Copiar1"
                        Content="+ Agregar juego"
                        Click="AddGameButton_Click" RenderTransformOrigin="0.5,0.557" Margin="765,0,20,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>


                    <TextBlock Text="Mis juegos"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>


                    <WrapPanel x:Name="GamesPanel"
                               ItemWidth="180"
                               ItemHeight="250"/>

                </StackPanel>

            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       x:Name="StatusTextBlock"
                       Margin="0,16,0,0"
                       Foreground="Gray"/>

        </Grid>


        <!-- VISTA DEL JUEGO -->
        <Grid x:Name="GameView"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    x:Name="BackToLibraryButton"
                    Content="← Volver"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Left"
                    Click="BackToLibraryButton_Click"/>

            <ScrollViewer Grid.Row="1"
                          Margin="0,24,0,0"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock x:Name="SelectedGameNameTextBlock"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,0,0,24"/>

                    <Border Width="220"
                            Height="280"
                            HorizontalAlignment="Left"
                            Background="#F5F5F5"
                            CornerRadius="8">

                        <TextBlock Text="Sin carátula"
                                   Foreground="Gray"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="Información del juego"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,28,0,12"/>

                    <TextBlock x:Name="SelectedGameOriginTextBlock"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="SelectedGamePathTextBlock"
                               TextWrapping="Wrap"
                               Foreground="Gray"
                               Margin="0,0,0,24"/>


                    <TextBlock Text="Archivos vigilados"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <Border BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,24">

                        <StackPanel x:Name="TrackedSavesPanel"/>

                    </Border>



                </StackPanel>

            </ScrollViewer>

        </Grid>

        <!-- Nick -->
        <TextBlock Text="Dubstroy 2026" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom" 
                   FontSize="14" 
                   Foreground="Gray" Margin="0,0,21,0" />

    </Grid>

</Window>