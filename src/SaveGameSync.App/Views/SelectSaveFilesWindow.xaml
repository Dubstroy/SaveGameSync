<Window x:Class="SaveGameSync.App.Views.SelectSaveFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar archivos"
        Width="700"
        Height="600"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Seleccionar archivos del guardado"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Selecciona los archivos que SaveGameSync debe respaldar y vigilar."
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="FilesPanel"/>

            </ScrollViewer>

        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Seleccionar todos"
                    Width="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="SelectAllButton_Click"/>

            <Button Content="Ninguno"
                    Width="90"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="SelectNoneButton_Click"/>

            <Button Content="Cancelar"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Continuar"
                    Width="110"
                    Height="36"
                    Click="ContinueButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
